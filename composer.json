{
    "name": "bahari/laravel",
    "description": "Bahari Accounts for Laravel: customer and admin sign-in, session checks, back-channel logout, platform switcher and wallet links. Set three env values; endpoints are discovered.",
    "type": "library",
    "license": "MIT",
    "keywords": ["bahari", "sso", "oidc", "laravel"],
    "require": {
        "php": "^8.2",
        "bahari/sso-php": "^0.5",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": { "Bahari\\Laravel\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Bahari\\Laravel\\BahariServiceProvider"],
            "aliases": { "Bahari": "Bahari\\Laravel\\Facades\\Bahari" }
        }
    },
    "minimum-stability": "stable"
}
